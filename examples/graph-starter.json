{
  "id": "graph-starter",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "duration": 3.0,
  "background": "#111110",
  "motion_blur": { "enabled": true, "shutter_angle": 180, "samples": 8 },
  "layers": [
    {
      "kind": "nodes",
      "id": "world",
      "motion_blur": { "mode": "track", "node": "cam" },
      "nodes": [
        {
          "id": "cam",
          "type": "group",
          "origin": [0, 0],
          "props": {
            "y": { "initial": 0, "tweens": [{ "start": 1.2, "duration": 0.5, "to": -700, "ease": "power3_in_out" }] },
            "scale": { "initial": 1, "tweens": [{ "start": 2.0, "duration": 0.6, "to": 0.6, "ease": "expo_out" }] }
          },
          "children": [
            {
              "id": "card",
              "type": "rect",
              "x": 90, "y": 360, "width": 900, "height": 1100,
              "corner_radius": 48,
              "gradient": { "angle": 160, "stops": [[0, "#F0381F"], [1, "#2B1B6B"]] }
            },
            {
              "id": "badge",
              "type": "ellipse",
              "x": 760, "y": 300, "width": 220, "height": 220,
              "color": "#D4F02B",
              "props": {
                "rotation": { "initial": 0, "tweens": [{ "start": 0, "duration": 3, "to": 360 }] },
                "scale": { "keys": [[0, 0.0], [0.5, 1.0, "back_out"]] }
              }
            },
            {
              "id": "icon",
              "type": "svg",
              "x": 160, "y": 430, "width": 160, "height": 160,
              "data": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 20.3s-8.2-4.8-8.2-10.9A4.5 4.5 0 0 1 8.3 4.9c1.6 0 2.9.8 3.7 2.1.8-1.3 2.1-2.1 3.7-2.1a4.5 4.5 0 0 1 4.5 4.5c0 6.1-8.2 10.9-8.2 10.9z' fill='#fff'/></svg>"
            },
            {
              "id": "bars",
              "type": "rects",
              "x": 160, "y": 1100, "width": 760, "height": 260,
              "props": { "inset_right": { "initial": 1, "tweens": [{ "start": 0.3, "duration": 0.8, "to": 0, "ease": "power2_out" }] } },
              "rects": [[0, 0, 6, 260, "#F5F4EE"], [30, 0, 18, 260, "#F5F4EE"], [70, 0, 6, 260, "#F5F4EE"], [100, 0, 30, 260, "#F5F4EE"], [160, 0, 6, 260, "#F5F4EE"], [190, 0, 6, 260, "#F0381F"], [230, 0, 22, 260, "#F5F4EE"]]
            },
            {
              "id": "title",
              "type": "text",
              "x": 160, "y": 680, "width": 760,
              "text": "Any reel, one scene file",
              "font": "sans-serif", "weight": 700, "size": 92, "line_height": 1.05,
              "wrap": true, "color": "#FFFFFF",
              "shadow": { "color": "#00000080", "dy": 6, "blur": 12 },
              "tail_square": { "color": "#D4F02B" },
              "props": { "opacity": { "initial": 0, "tweens": [{ "start": 0.2, "duration": 0.4, "to": 1, "from": 0, "ease": "power2_out" }] } }
            }
          ]
        }
      ]
    },
    { "kind": "grade", "desaturate": { "initial": 0, "tweens": [{ "start": 2.4, "duration": 0.3, "to": 1 }] } },
    {
      "kind": "nodes",
      "id": "top",
      "nodes": [
        {
          "type": "text",
          "x": 0, "y": 1640, "width": 1080,
          "text": "boxed caption",
          "font": "sans-serif", "weight": 500, "size": 66, "line_height": 1.1,
          "align": "center", "color": "#111110",
          "background": { "color": "#D4F02B", "padding": [6, 24, 10, 24] },
          "props": {
            "opacity": { "initial": 0, "tweens": [{ "start": 0.8, "duration": 0.2, "to": 1, "from": 0 }] },
            "blur": { "initial": 6, "tweens": [{ "start": 0.8, "duration": 0.2, "to": 0, "from": 6 }] }
          }
        }
      ]
    }
  ]
}
